# --- data (never commit raw/processed data) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/raw/CHECKSUMS.sha256
# manifests ARE committed (small JSON split files)

# --- outputs / artifacts: ignored by default; only small experiment results are re-included below ---
outputs/*
artifacts/*
!outputs/.gitkeep
!artifacts/.gitkeep
!outputs/a0_*/
!outputs/a0b_*/
!outputs/a2_*/
outputs/a0_*/*
outputs/a0b_*/*
outputs/a2_*/*
!outputs/a0_*/provenance.json
!outputs/a0b_*/provenance.json
!outputs/a2_*/provenance.json
!outputs/a0_*/config.yaml
!outputs/a0b_*/config.yaml
!outputs/a2_*/config.yaml
