      "tier": "primary",
      "unit": "ms",
      "coverage_required": true,
      "event_pair": "P->S"
    }
  },
  "topology_definitions": {
    "T0": "M == K AND every supplied event assigned to a unique GT event within +-150 ms AND no unmatched GT AND no unmatched S",
    "T1": "M == K but the event set is imperfect at +-150 ms",
    "T2": "M < K (undercount)",
    "T3": "M > K (overcount)"
  },
  "matching": {
    "S_to_G": {
      "tolerance_ms": 150.0,
      "synthetic_arms": "exact construction identity from O3/E1",
      "predicted_schedules": "monotonic one-to-one dynamic-programming assignment",
      "objective_hierarchy": [
        "maximise matched cardinality",
        "minimise total absolute timing error",
        "deterministic tie break: transition preference match -> skip-ref -> skip-pred, indices ascending"
      ],
      "label": "TARGET-DERIVED DIAGNOSTIC MATCHING",
      "prohibited": [
        "shift S",
        "repair S",
        "insert events",
        "delete events",
        "modify inference"
      ]
    },
    "P_to_S": {
      "tolerance_ms": 50.0,
      "matcher": "frozen greedy one-to-one rpeaks.match_rpeaks"
    },
    "P_to_G": {
      "tolerances_ms": [
        50.0,
        100.0,
        150.0,
        200.0
      ],
      "matcher": "frozen greedy one-to-one rpeaks.match_rpeaks"
    }
  },
  "support": {
    "own_centre": [
      -10,
      15
    ],
    "gt_anchored": [
      -10,
      15
    ],
    "derivative_slice": [
      -11,
      12
    ],
    "eligibility": "c - 11 >= 0 and c + 15 <= n_time - 1",
    "fs": 128,
    "n_time": 1024,
    "prohibited": [
      "local cross-correlation shift",
      "DTW",
      "oracle shift",
      "amplitude optimisation",
      "waveform renormalisation beyond the frozen preprocessing"
    ]
  },
  "normalization": {
    "T4_train_IQR": 0.5053170621395111,
    "T6_train_IQR": 0.22995377704501152,
    "T7_train_IQR": 0.033796727107052275,
    "T8_train_IQR": 31.25,
    "source": "artifacts/o1_component_extractability/target_scaling.json (frozen O1 train IQRs)"
  },
  "aggregation": {
    "order": [
      "per-beat",
      "median within window",
      "mean within subject",
      "equal-subject macro"
    ],
    "subjects": [
      "an0",
      "k2s"
    ],
    "note": "unless a metric definition itself specifies otherwise"
  },
  "bootstrap": {
    "unit": "underlying ECG-window cluster (all four site rows of one target ECG move together)",
    "stratification": "subject, equal weight",
    "n_replicates": 2000,
    "rng": "default_rng(20260904)",
    "prohibited": [
      "bootstrapping beats independently"
    ]
  },
  "effect_orientation": {
    "higher_is_better": "effect = NEW - REFERENCE",
    "lower_is_better": "effect = REFERENCE - NEW",
    "meaning": "positive always means NEW is better",
    "damage_tables_only": "Damage = Error_condition - Error_reference; the table title MUST say 'positive = more damage'",
    "prohibited": [
      "mixing conventions within one table"
    ]
  },
  "coverage_requirements": {
    "C1_schedule_to_gt_identity": "fraction of supplied events carrying a GT identity",
    "C2_generated_to_supplied_adherence": "fraction of identified supplied events matched by a generated event",
    "C3_full_chain_P_S_G": "fraction of supplied events with a complete eligible chain",
    "C4_gt_beats_excluded": "fraction of GT beats absent from the own-centre comparison",
    "C5_generated_beats_excluded": "fraction of generated beats absent from the own-centre comparison",
    "rule": "every morphology metric row must carry all five; morphology reported without coverage is INVALID",
    "own_centre_does_not_penalise": [
